# XG2010G Test-4B package parity target.
# These packages were present in the uploaded working/base firmware but absent from Test-4B v1.
# Keep all of them selected; do not drop PON/PHY/firmware packages just to make CI green.

CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_airoha-oamd=y
CONFIG_PACKAGE_airoha-omcid=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-kpp=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y
CONFIG_PACKAGE_kmod-crypto-manager=y
CONFIG_PACKAGE_kmod-crypto-null=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-i2c-core=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-libphy=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-bridge=y
