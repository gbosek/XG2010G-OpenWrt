From: XG2010G Test-3
Subject: [PATCH] arm64: dts: airoha: match working XG2010G UBI layout

This layout is taken from the user's currently working 14,098,704-byte
XG2010G sysupgrade ITB DTB, not inferred from the Test-2 tree.

Observed working DT layout:
- bl2: reg <0x00000000 0x00020000>, read-only
- ubi: reg <0x00020000 0x00000000>, linux,ubi
- UBI volumes declared by DT: factory, fip, ubootenv, ubootenv2, fit
- PON calibration: factory offset 0x12000 length 0x200

Keep the baseline MAC nvmem cell because the newer common DTSI references it;
add the working PON calibration cell alongside it. This remains
initramfs-validation-only and does not authorize flash writes.

--- a/target/linux/airoha/dts/an7581-gemtek-xg2010g.dts
+++ b/target/linux/airoha/dts/an7581-gemtek-xg2010g.dts
@@ -24,33 +24,17 @@
-		bootloader@0 {
-			label = "bootloader";
-			reg = <0x00000000 0x00200000>;
+		bl2@0 {
+			label = "bl2";
+			reg = <0x00000000 0x00020000>;
 			read-only;
 		};
 
-		uenv@200000 {
-			label = "uenv";
-			reg = <0x00200000 0x00200000>;
-			read-only;
-		};
-
-		dsd@400000 {
-			label = "dsd";
-			reg = <0x00400000 0x00200000>;
-			read-only;
-		};
-
-		ubi@600000 {
+		ubi@20000 {
 			label = "ubi";
-			reg = <0x00600000 0x1b800000>;
+			reg = <0x00020000 0x00000000>;
 			compatible = "linux,ubi";
 
 			volumes {
-				ubi-volume-bosa {
-					volname = "bosa";
-				};
-
 				ubi-volume-factory {
-					volname = "ri";
+					volname = "factory";
@@ -63,6 +47,10 @@
 							#nvmem-cell-cells = <1>;
 						};
+
+						pon_calibration: calibration@12000 {
+							reg = <0x12000 0x200>;
+						};
 					};
 				};
@@ -73,6 +61,14 @@
 				ubi-volume-fip {
 					volname = "fip";
 				};
+
+				ubi_env: ubi-volume-ubootenv {
+					volname = "ubootenv";
+				};
+
+				ubi_env2: ubi-volume-ubootenv2 {
+					volname = "ubootenv2";
+				};
 			};
 		};
@@ -80,10 +76,18 @@
-		reserved-bmt@1be00000 {
-			label = "reserved_bmt";
-			reg = <0x1be00000 0x04200000>;
-			read-only;
-		};
 	};
 };
+
+&ubi_env {
+	nvmem-layout {
+		compatible = "u-boot,env-redundant-bool-layout";
+	};
+};
+
+&ubi_env2 {
+	nvmem-layout {
+		compatible = "u-boot,env-redundant-bool-layout";
+	};
+};
 
 &pcie0 { status = "disabled"; };
