#!/bin/sh
set -eu

usage() {
	cat <<'EOF'
Usage: xg2010g-pon COMMAND [ARGS...]
  status
  apply
  start
  stop
  restart
  datapath-set ALLOC_ID GEM_ID
  datapath-clear
  datapath-show
  wait-o5 [TIMEOUT]
EOF
}

have() { command -v "$1" >/dev/null 2>&1; }
need() { have "$1" || { echo "missing required command: $1" >&2; exit 127; }; }

valid_mode() {
	case "$1" in
		''|gpon|xgpon|xgspon|epon-1g|epon-10g-1g|epon-10g-10g) return 0 ;;
		*) return 1 ;;
	esac
}

valid_serial() {
	v="$1"
	[ -z "$v" ] && return 0
	[ "$v" = default ] && return 0

	# ponctl accepts either 16 raw hex digits or VEND + 8 hex digits.
	if [ ${#v} -eq 16 ]; then
		case "$v" in
			*[!0-9A-Fa-f]*) return 1 ;;
			*) return 0 ;;
		esac
	fi

	[ ${#v} -eq 12 ] || return 1
	vendor=${v%????????}
	serial=${v#????}
	case "$vendor" in *[!A-Za-z0-9]*) return 1 ;; esac
	case "$serial" in *[!0-9A-Fa-f]*) return 1 ;; esac
	return 0
}

valid_registration_id() {
	v="$1"
	[ -z "$v" ] && return 0
	[ "$v" = default ] && return 0
	case "$v" in
		hex:*)
			x=${v#hex:}
			[ ${#x} -eq 72 ] || return 1
			case "$x" in *[!0-9A-Fa-f]*) return 1 ;; esac
			return 0
			;;
		text:*)
			t=${v#text:}
			[ "$(printf %s "$t" | wc -c)" -le 36 ]
			return
			;;
		*) return 1 ;;
	esac
}

pon_device() {
	uci -q get pon.line0.device 2>/dev/null || printf '%s\n' pon0
}

pon_mode() {
	uci -q get pon.line0.mode 2>/dev/null || true
}

show_cmd() {
	dev="$1"
	shift
	echo
	printf '%s' '-- ponctl'
	printf ' %s' "$@"
	printf ' --\n'
	ponctl --device "$dev" "$@" 2>&1 || true
}

show_status() {
	need ponctl
	dev="$(pon_device)"
	echo "== XG2010G PON =="
	echo "device=$dev"
	echo "configured_mode=$(pon_mode)"

	show_cmd "$dev" status
	show_cmd "$dev" mode show
	show_cmd "$dev" identity show
	show_cmd "$dev" data-path show
	show_cmd "$dev" data-path stats
	show_cmd "$dev" frontend
	show_cmd "$dev" control

	echo
	echo "-- interfaces --"
	ip -br link show "$dev" 2>/dev/null || true
	ip -br link show omci0 2>/dev/null || true
	ip -br link show oam0 2>/dev/null || true

	echo
	echo "-- management agents --"
	if have omcictl; then
		omcictl status --instance line0_omci 2>&1 || true
	fi
	if have oamctl; then
		oamctl status --instance line0_oam 2>&1 || true
	fi

	echo
	echo "-- services --"
	/etc/init.d/pon status 2>&1 || true
	/etc/init.d/airoha-omcid status 2>&1 || true
	/etc/init.d/airoha-oamd status 2>&1 || true
}

restart_management() {
	mode="$(pon_mode)"
	case "$mode" in
		epon-*)
			/etc/init.d/airoha-omcid stop 2>/dev/null || true
			/etc/init.d/airoha-oamd restart
			;;
		*)
			/etc/init.d/airoha-oamd stop 2>/dev/null || true
			/etc/init.d/airoha-omcid restart
			;;
	esac
}

start_management() {
	mode="$(pon_mode)"
	case "$mode" in
		epon-*)
			/etc/init.d/airoha-omcid stop 2>/dev/null || true
			/etc/init.d/airoha-oamd start
			;;
		*)
			/etc/init.d/airoha-oamd stop 2>/dev/null || true
			/etc/init.d/airoha-omcid start
			;;
	esac
}

apply_config() {
	need ponctl
	need uci
	mode="$(uci -q get pon.line0.mode 2>/dev/null || true)"
	serial="$(uci -q get pon.line0.serial_number 2>/dev/null || true)"
	regid="$(uci -q get pon.line0.registration_id 2>/dev/null || true)"

	valid_mode "$mode" || { echo "invalid PON mode: $mode" >&2; exit 2; }
	valid_serial "$serial" || { echo "invalid serial_number" >&2; exit 2; }
	valid_registration_id "$regid" || { echo "invalid registration_id" >&2; exit 2; }

	# LuCI writes the UCI values first; commit here so the active identity survives reboot.
	uci commit pon
	/etc/init.d/pon reload
	restart_management
	show_status
}

service_action() {
	action="$1"
	case "$action" in
		start)
			/etc/init.d/pon start
			start_management
			;;
		stop)
			/etc/init.d/airoha-omcid stop 2>/dev/null || true
			/etc/init.d/airoha-oamd stop 2>/dev/null || true
			/etc/init.d/pon stop
			;;
		restart)
			/etc/init.d/airoha-omcid stop 2>/dev/null || true
			/etc/init.d/airoha-oamd stop 2>/dev/null || true
			/etc/init.d/pon restart || /etc/init.d/pon reload
			start_management
			;;
	esac
	show_status
}

need uci
cmd="${1:-}"
case "$cmd" in
	status) show_status ;;
	apply) apply_config ;;
	start|stop|restart) service_action "$cmd" ;;
	datapath-set)
		need ponctl
		alloc="${2:-}"; gem="${3:-}"
		case "$alloc" in ''|*[!0-9]*) echo "ALLOC_ID must be decimal" >&2; exit 2 ;; esac
		case "$gem" in ''|*[!0-9]*) echo "GEM_ID must be decimal" >&2; exit 2 ;; esac
		ponctl --device "$(pon_device)" data-path set --alloc-id "$alloc" --gem-id "$gem"
		ponctl --device "$(pon_device)" data-path show
		;;
	datapath-clear)
		need ponctl
		ponctl --device "$(pon_device)" data-path clear
		ponctl --device "$(pon_device)" data-path show
		;;
	datapath-show)
		need ponctl
		ponctl --device "$(pon_device)" data-path show
		;;
	wait-o5)
		need ponctl
		timeout="${2:-60}"
		case "$timeout" in ''|*[!0-9]*) echo "timeout must be decimal seconds" >&2; exit 2 ;; esac
		ponctl --device "$(pon_device)" wait-o5 --timeout "$timeout"
		;;
	*) usage >&2; exit 2 ;;
esac
