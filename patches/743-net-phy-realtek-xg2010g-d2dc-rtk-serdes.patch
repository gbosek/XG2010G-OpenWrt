From: XG2010G Test-2
Subject: [PATCH] net: phy: realtek: add XG2010G RTL8261 host SerDes tuning

Layer the XG2010G-specific RTL8261 host-side SerDes tuning on top of the
existing 743 RTL8261N/RTL8261BE delayed USXGMII reset workaround already
present in the b6bd44a Linux 6.18.44 baseline.

Keep the tuning opt-in through realtek,patch-rtk-serdes. Append the two
flow_s values to the firmware patch database for initial configuration,
and re-apply them after the baseline delayed SerDes reset releases the
USXGMII block. This deliberately reuses the baseline recovery worker
instead of adding a second carrier/retry state machine.

--- a/drivers/net/phy/realtek/phy_patch_rtl826x.c
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.c
@@ -230,7 +230,7 @@ static int rtl826x_phy_patch_db_init(struct phy_device *phydev, const char *fw_name)
 	struct rtlgen_phy_patch_db *patch_db;
 	struct rtlgen_hwpatch *patches;
 	const struct firmware *fw;
-	size_t count;
+	size_t count, extra_count, total_count;
 	int ret;
 
 	ret = request_firmware_direct(&fw, fw_name, dev);
@@ -253,15 +253,43 @@ static int rtl826x_phy_patch_db_init(struct phy_device *phydev, const char *fw_name)
 
 	patches = (struct rtlgen_hwpatch *)fw->data;
 	count = fw->size / sizeof(*patches);
+	priv->patch_rtk_serdes =
+		device_property_read_bool(dev, "realtek,patch-rtk-serdes");
+	extra_count = priv->patch_rtk_serdes ? 2 : 0;
+	total_count = count + extra_count;
+	if (total_count < count) {
+		ret = -EOVERFLOW;
+		goto out;
+	}
 
-	patch_db = devm_kzalloc(dev, struct_size(patch_db, conf, count), GFP_KERNEL);
+	patch_db = devm_kzalloc(dev, struct_size(patch_db, conf, total_count), GFP_KERNEL);
 	if (!patch_db) {
 		ret = -ENOMEM;
 		goto out;
 	}
 
-	patch_db->count = count;
+	patch_db->count = total_count;
 	patch_db->patch_op_exec = rtl826x_phy_patch_op;
 
 	memcpy(patch_db->conf, patches, flex_array_size(patch_db, conf, count));
+	if (priv->patch_rtk_serdes) {
+		patch_db->conf[count] = (struct rtlgen_hwpatch) {
+			.patch_op = RTK_PATCH_OP_PSDS0,
+			.portmask = 0xff,
+			.pagemmd = cpu_to_le16(0x07),
+			.addr = cpu_to_le16(0x10),
+			.msb = 15,
+			.lsb = 0,
+			.data = cpu_to_le16(0x80aa),
+		};
+		patch_db->conf[count + 1] = (struct rtlgen_hwpatch) {
+			.patch_op = RTK_PATCH_OP_PSDS0,
+			.portmask = 0xff,
+			.pagemmd = cpu_to_le16(0x06),
+			.addr = cpu_to_le16(0x12),
+			.msb = 15,
+			.lsb = 0,
+			.data = cpu_to_le16(0x5078),
+		};
+	}
 
 	priv->patch = patch_db;
 
--- a/drivers/net/phy/realtek/realtek.h
+++ b/drivers/net/phy/realtek/realtek.h
@@ -11,9 +11,10 @@ struct rtl826x_priv {
 	struct rtlgen_phy_patch_db *patch;
 	bool enable_pma_low_power:1;
 	struct phy_device *phydev;
 	struct delayed_work sds_work;
 	bool sds_work_disabled;
 	unsigned int sds_retries;
+	bool patch_rtk_serdes:1;
 };
 
 int rtl822x_hwmon_init(struct phy_device *phydev);
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -2968,6 +2968,11 @@ static void rtl826x_sds_reset_work(struct work_struct *work)
 	rtl826x_phy_patch_sds_set(phydev, RTL826X_SDS_PAGE_RESET,
 				  RTL826X_SDS_REG_RESET, RTL826X_SDS_RESET_RELEASE);
 
+	if (priv->patch_rtk_serdes) {
+		rtl826x_phy_patch_sds_set(phydev, 0x07, 0x10, 0x80aa);
+		rtl826x_phy_patch_sds_set(phydev, 0x06, 0x12, 0x5078);
+	}
+
 	schedule_delayed_work(&priv->sds_work,
 			      msecs_to_jiffies(RTL826X_SDS_POLL_MS));
 }
